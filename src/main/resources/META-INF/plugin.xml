<!--
  NOTE: name / description / change-notes / vendor / idea-version are patched by
  build.gradle.kts (intellijPlatform.pluginConfiguration) at build time — the values
  below are kept in sync for readability and are NOT what ships in the release ZIP.
  Plugin ID is permanent: never change <id> once the plugin is published.
-->
<idea-plugin>
    <id>com.luapanda.idea</id>
    <name>LuaPanda</name>
    <vendor email="1963249614@qq.com" url="https://github.com/MrHQK/LuaPanda-IDEA-Plugin">LuaPanda</vendor>

    <description><![CDATA[
        <h2>LuaPanda Debugger for IntelliJ IDEA</h2>
        <p>IntelliJ IDEA 平台的 Lua 调试插件，移植自腾讯开源的 LuaPanda VSCode 扩展。</p>
        <p><b>专注调试功能，与 EmmyLua 协同工作</b> — 本插件提供调试能力，EmmyLua 提供语法高亮、代码补全等语言支持。两个插件可同时安装、互不冲突。</p>
        <h3>功能特性 / Features</h3>
        <ul>
            <li><b>断点调试</b>：行断点、条件断点、日志断点 (Logpoint)，支持 Step Over / Into / Out</li>
            <li><b>断点管理器</b>：集中查看、跳转、启用/禁用、按文件夹/类型过滤、右键编辑条件/日志、一键批量管理所有 Lua 断点</li>
            <li><b>变量查看</b>：Locals / Upvalues / Globals 分组展示，支持 table 展开</li>
            <li><b>表达式求值</b>：Evaluate Expression 对话框、Watch 面板、REPL 控制台</li>
            <li><b>双连接模式</b>：Server 模式（本地调试）+ Client 模式（真机/远程调试）</li>
            <li><b>使用模板</b>：配置界面内嵌实时代码模板，自动生成 Lua 接入代码</li>
            <li><b>C Hook 加速</b>：内置 libpdebug 预编译库，调试性能提升 10~100 倍</li>
            <li><b>代码质量</b>：集成 lua-fmt（格式化）和 luacheck（静态分析）</li>
            <li><b>协议兼容</b>：完全兼容原版 LuaPanda.lua TCP/JSON 协议</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>1.0.3</h3>
        <ul>
            <li><b>修复</b>：移除对 IntelliJ 内部 API 的引用（Plugin Verifier 报 "Internal API usage" 导致上架被拒），改用公开 API 实现同等功能</li>
        </ul>
        <h3>1.0.2</h3>
        <ul>
            <li><b>新增</b>：按变量名搜索当前堆栈帧变量 —— 断点暂停时可按名称或完整路径过滤 Locals / Upvalues / Globals，支持正则匹配与 table 递归展开，结果可一键加入 Watches</li>
            <li><b>修复</b>：演示点 5「调用堆栈」因 Lua 尾调用导致 <code>stack_level_1/2</code> 不出现在 Frames 面板，改为非尾调用后恢复完整三层栈</li>
            <li><b>文档</b>：修正插件描述，使其与「专注调试、语言特性交给 EmmyLua」的实际能力一致</li>
        </ul>
        <h3>1.0.1</h3>
        <ul>
            <li><b>修复</b>：远程调试场景下"僵尸 socket"导致 <code>Connection reset</code> 死循环（与 VSCode 扩展行为对齐）</li>
            <li><b>修复</b>：Hover 表达式求值总是显示路径最右段值，现在悬浮在哪段就显示到那段为止的值</li>
            <li><b>体验</b>：Console "LuaPanda connected" 提示改为握手成功后才打印，避免误导</li>
            <li><b>工具</b>：新增一键打包脚本 <code>scripts/pack.ps1</code>（Windows）</li>
        </ul>
        <h3>1.0.0</h3>
        <ul>
            <li>首个正式版本</li>
            <li>完整断点调试（行断点、条件断点、日志断点）</li>
            <li>Server / Client 双连接模式</li>
            <li>使用模板（配置界面实时代码模板）</li>
            <li>内置 libpdebug C Hook 库自动加载</li>
            <li>EmmyLua 断点兼容</li>
            <li>lua-fmt 格式化 + luacheck 静态分析集成</li>
        </ul>
    ]]></change-notes>

    <!-- IntelliJ Platform compatibility -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ==================== Debugger ==================== -->
        <!-- Run Configuration Type -->
        <configurationType
                implementationClass="com.luapanda.idea.debugger.LuaPandaRunConfigurationType"/>

        <!-- Program Runner -->
        <programRunner
                implementation="com.luapanda.idea.debugger.LuaPandaProgramRunner"/>

        <!-- Breakpoint Type -->
        <xdebugger.breakpointType
                implementationClass="com.luapanda.idea.debugger.LuaPandaBreakpointType"/>

        <!-- ==================== Settings ==================== -->
        <applicationConfigurable
                parentId="tools"
                instance="com.luapanda.idea.settings.LuaPandaSettingsConfigurable"
                id="com.luapanda.idea.settings"
                displayName="LuaPanda"/>

        <applicationService
                serviceImplementation="com.luapanda.idea.settings.LuaPandaSettings"/>

        <!-- Project-level Lua file index cache: avoids re-scanning 37K+ files on each debug session -->
        <projectService
                serviceImplementation="com.luapanda.idea.debugger.LuaFileIndexService"/>

        <!-- Pre-scan Lua files at project open so the first debug session also gets 0ms cache hit -->
        <postStartupActivity
                implementation="com.luapanda.idea.debugger.LuaFileIndexStartupActivity"/>

        <!-- ==================== Tool Windows ==================== -->
        <!-- Breakpoint Manager Tool Window -->
        <toolWindow id="Lua Breakpoints"
                    anchor="bottom"
                    icon="com.luapanda.idea.LuaPandaIcons.BREAKPOINT_MANAGER"
                    factoryClass="com.luapanda.idea.debugger.breakpoints.LuaBreakpointManagerToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Copy LuaPanda.lua to Project action -->
        <action id="LuaPanda.CopyDebuggerToProject"
                class="com.luapanda.idea.actions.CopyLuaPandaAction"
                text="Copy LuaPanda.lua to Project"
                description="Copy LuaPanda.lua debugger file to current project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- Format with lua-fmt -->
        <action id="LuaPanda.FormatWithLuaFmt"
                class="com.luapanda.idea.formatter.FormatWithLuaFmtAction"
                text="Format with lua-fmt"
                description="Format current Lua file using lua-fmt">
            <add-to-group group-id="CodeFormatGroup" anchor="last"/>
        </action>

        <!-- Search variables of the current stack frame while paused -->
        <action id="LuaPanda.SearchVariables"
                class="com.luapanda.idea.actions.SearchLuaVariablesAction"
                text="Search Lua Variables..."
                description="Search variables of the current stack frame by name">
            <add-to-group group-id="XDebugger.Variables.Tree.Toolbar" anchor="last"/>
            <add-to-group group-id="XDebugger.Variables.Tree.Popup" anchor="last"/>
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
